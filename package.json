{
  "name": "reconcile-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:worker": "cd worker && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:worker && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:worker": "cd worker && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "db:generate": "cd database && npx prisma generate",
    "db:push": "cd database && npx prisma db push",
    "db:seed": "cd database && npm run seed",
    "test": "cd tests && npm run test",
    "test:e2e": "cd tests && npm run test:e2e",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  }
}
