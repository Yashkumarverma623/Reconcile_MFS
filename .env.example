# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reconcile_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server Ports
PORT=5000
FRONTEND_PORT=3000

# File Storage
UPLOAD_DIR="./uploads"

# Node Env
NODE_ENV="development"
